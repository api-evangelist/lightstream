              {
                "name": "sourceId",
                "value": "",
                "type": "path",
                "description": "live source id"
              },
              {
                "name": "force",
                "value": "",
                "type": "query",
                "description": "delete a live source even if it is in use in a broadcast."
              }
            ]
          },
          "docs": "Deletes a live source from a collection"
