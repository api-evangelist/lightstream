            "name": "Update Source",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/collection/:collectionId/source/:sourceId",
            "params": [
              {
                "name": "collectionId",
                "value": "",
                "type": "path",
                "description": "collection which owns the project which owns the source"
              },
              {
                "name": "sourceId",
                "value": "",
                "type": "path",
                "description": "source id"
              }
            ]
          },
          "docs": "Update attributes of the Source."
        },
        {
          "info": {
            "name": "Delete Live Source",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/collection/:collectionId/source/:sourceId",
            "params": [
              {
                "name": "collectionId",
                "value": "",
