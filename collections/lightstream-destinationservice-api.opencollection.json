            "params": [
              {
                "name": "collectionId",
                "value": "",
                "type": "path",
                "description": "collection which owns the project which owns the destination"
              },
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "project which owns the destination"
              },
              {
                "name": "destinationId",
                "value": "",
                "type": "path",
                "description": "destination id"
              }
            ]
          },
          "docs": "Update a destination"
        },
        {
          "info": {
            "name": "Delete Destination",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/collection/:collectionId/project/:projectId/destination/:destinationId",
            "params": [
              {
                "name": "collectionId",
                "value": "",
                "type": "path",
                "description": "collection which owns the project which owns the destination"
              },
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "project which owns the destination"
              },
              {
                "name": "destinationId",
                "value": "",
                "type": "path",
                "description": "destination id"
              },
              {
                "name": "force",
                "value": "",
                "type": "query",
                "description": "forcibly remove destination if enabled."
              }
            ]
          },
          "docs": "Delete a destination"
