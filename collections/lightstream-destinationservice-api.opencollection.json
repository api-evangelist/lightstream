  "items": [
    {
      "info": {
        "name": "DestinationService",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Destination",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/collection/:collectionId/project/:projectId/destination",
            "params": [
              {
                "name": "collectionId",
                "value": "",
                "type": "path",
                "description": "collection which owns the project which owns the destination"
              },
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "project which will own this destination"
              }
            ]
          },
          "docs": "Create a new Destination"
        },
        {
          "info": {
            "name": "Get Destination",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/collection/:collectionId/project/:projectId/destination/:destinationId",
            "params": [
              {
                "name": "collectionId",
                "value": "",
                "type": "path",
                "description": "collection which owns the project which owns the destination"
              },
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "project which owns the destination"
              },
              {
                "name": "destinationId",
                "value": "",
                "type": "path",
                "description": "destination id"
              }
            ]
          },
          "docs": "Get an existing Destination."
        },
        {
          "info": {
            "name": "Update Destination",
            "type": "http"
